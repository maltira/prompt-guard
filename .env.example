# адрес шлюза без /v1 на конце
ANTHROPIC_BASE_URL=

# ключ шлюза (токен)
ANTHROPIC_AUTH_TOKEN=

# идентификатор модели
LLM_MODEL=claude-haiku-5-5

# цена за 1M токенов в USD
LLM_PRICE_IN_PER_M=0.10
LLM_PRICE_OUT_PER_M=0.50

# временно: минимальная пауза между запросами к API в секундах, чтобы не получать 429
LLM_MIN_INTERVAL_S=1.2
