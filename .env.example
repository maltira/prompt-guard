# адрес шлюза без /v1 на конце
ANTHROPIC_BASE_URL=

# ключ шлюза (токен)
ANTHROPIC_AUTH_TOKEN=

# идентификатор модели
LLM_MODEL=claude-haiku-5-5

# цена за 1M токенов в USD
LLM_PRICE_IN_PER_M=0.10
LLM_PRICE_OUT_PER_M=0.50

# временно: минимальная пауза между запросами к API в секундах, чтобы не получать 429
LLM_MIN_INTERVAL_S=1.2

# фиктивный секрет в системной подсказке мишени (настоящих данных в проекте нет)
TARGET_SECRET=KOLIBRI-7391-ZETA

# режим мишени: direct (письмо сразу ассистенту) или gateway (сначала проверка шлюзом)
MODE=direct

# адрес шлюза для режима gateway
GATEWAY_URL=http://localhost:8000

# конфигурация мишени: default (обычный агент) или naive (намеренно уязвимая, для демонстрации шлюза)
TARGET_PERSONA=default

# бэкенд мишени: api (Haiku через API) или local (слабая локальная модель без API)
TARGET_BACKEND=api

# локальная модель для слабого ассистента (скачивается заранее, во время запроса не загружается)
TARGET_LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
